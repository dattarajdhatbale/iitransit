rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
      function isStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@iitbbs\\.ac\\.in');
    }

    match /users/{uid} {
      allow read, delete: if isStudent() && request.auth.uid == uid;
      allow create, update: if isStudent()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['contact', 'updatedAt'])
        && (!('contact' in request.resource.data)
            || (request.resource.data.contact is string
                && request.resource.data.contact.matches('[6-9][0-9]{9}')));
    }

    match /alerts/{alertId} {
      allow get: if isStudent()
        && (resource == null
            ? alertId.matches('^' + request.auth.uid + '_.*')
            : resource.data.uid == request.auth.uid);
      allow list, delete: if isStudent() && resource.data.uid == request.auth.uid;
      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && alertId.matches('^' + request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['uid', 'date', 'from', 'to', 'createdAt', 'seenRideIds'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.from is string
        && request.resource.data.to is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.seenRideIds is list
        && request.resource.data.seenRideIds.size() == 0;
      allow update: if isStudent()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenRideIds', 'firstMatchSeenAt'])
        && request.resource.data.seenRideIds is list
        && request.resource.data.seenRideIds.size() <= 50
        && (!('firstMatchSeenAt' in request.resource.data)
            || (resource.data.get('firstMatchSeenAt', null) != null
                ? request.resource.data.firstMatchSeenAt == resource.data.firstMatchSeenAt
                : request.resource.data.firstMatchSeenAt == request.time));
    }

    match /rides/{rideId} {
      allow read: if request.auth != null
                  && request.auth.token.email.matches('.*@iitbbs\\.ac\\.in');
      allow create: if request.auth != null
                    && request.auth.token.email.matches('.*@iitbbs\\.ac\\.in')
                    && request.resource.data.postedBy.uid == request.auth.uid;
      allow update: if request.auth != null 
  && request.auth.token.email.matches('.*@iitbbs\\.ac\\.in')
  && (
    // The original poster can update the full document
    resource.data.postedBy.uid == request.auth.uid
    ||
    // Any verified student can ONLY increment contactClicks by exactly 1.
    // get() with default 0 handles rides posted before this field existed.
    (
      request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['contactClicks'])
      && request.resource.data.contactClicks == 
         (resource.data.get('contactClicks', 0) + 1)
    )
  );

      allow delete: if false;
    }
  }
}